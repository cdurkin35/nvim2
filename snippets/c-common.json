{
  "Header file skeleton": {
    "prefix": "hdr",
    "description": "Header with include guard and extern \"C\" wrapper",
    "body": [
      "#ifndef ${1:${TM_FILENAME_BASE}}_H",
      "#define ${1}_H",
      "",
      "#ifdef __cplusplus",
      "extern \"C\" {",
      "#endif",
      "",
      "${0}",
      "",
      "#ifdef __cplusplus",
      "}",
      "#endif",
      "",
      "#endif /* ${1}_H */"
    ]
  },
  "extern C block": {
    "prefix": "externc",
    "description": "extern \"C\" guard block",
    "body": [
      "#ifdef __cplusplus",
      "extern \"C\" {",
      "#endif",
      "",
      "${0}",
      "",
      "#ifdef __cplusplus",
      "}",
      "#endif"
    ]
  },
  "File header comment": {
    "prefix": "fhdr",
    "description": "Doxygen file header",
    "body": [
      "/**",
      " * @file    ${TM_FILENAME}",
      " * @brief   ${1:Brief description}",
      " *",
      " * ${0}",
      " */"
    ]
  },
  "Function doc comment": {
    "prefix": "fdoc",
    "description": "Doxygen function comment",
    "body": [
      "/**",
      " * @brief ${1:Brief description}",
      " *",
      " * @param ${2:name} ${3:Description}",
      " * @return ${4:Description}",
      " */"
    ]
  },
  "Section banner": {
    "prefix": "banner",
    "description": "Section separator comment",
    "body": [
      "/* ---------------------------------------------------------------------------",
      " * ${1:Section}",
      " * ------------------------------------------------------------------------- */",
      "${0}"
    ]
  },
  "Memory-mapped register": {
    "prefix": "reg32",
    "description": "Memory-mapped 32-bit register macro",
    "body": [
      "#define ${1:REG_NAME} (*(volatile uint32_t *)${2:0x40000000UL})"
    ]
  },
  "BIT macro": {
    "prefix": "bitm",
    "description": "BIT(n) macro",
    "body": [
      "#define BIT(n) (1UL << (n))"
    ]
  },
  "Set bit": {
    "prefix": "bitset",
    "description": "Set a bit",
    "body": [
      "${1:reg} |= (1UL << ${2:bit});"
    ]
  },
  "Clear bit": {
    "prefix": "bitclr",
    "description": "Clear a bit",
    "body": [
      "${1:reg} &= ~(1UL << ${2:bit});"
    ]
  },
  "Toggle bit": {
    "prefix": "bittog",
    "description": "Toggle a bit",
    "body": [
      "${1:reg} ^= (1UL << ${2:bit});"
    ]
  },
  "Test bit": {
    "prefix": "bitchk",
    "description": "Test a bit",
    "body": [
      "((${1:reg} >> ${2:bit}) & 1UL)"
    ]
  },
  "Write bit field": {
    "prefix": "bitfld",
    "description": "Read-modify-write a bit field",
    "body": [
      "${1:reg} = (${1} & ~(${2:MASK} << ${3:SHIFT})) | (((${4:value}) & ${2}) << ${3});"
    ]
  },
  "Wait for flag": {
    "prefix": "waitflag",
    "description": "Busy-wait on a status flag with timeout",
    "body": [
      "uint32_t ${1:timeout} = ${2:100000U};",
      "while (!(${3:REG} & ${4:FLAG}) && --${1}) {",
      "}",
      "if (${1} == 0U) {",
      "\t${0:return -1;}",
      "}"
    ]
  },
  "Interrupt handler": {
    "prefix": "isr",
    "description": "Interrupt service routine",
    "body": [
      "void ${1:TIM2}_IRQHandler(void)",
      "{",
      "\tif (${2:/* flag set */}) {",
      "\t\t${3:/* clear flag */}",
      "\t\t${0}",
      "\t}",
      "}"
    ]
  },
  "Critical section (CMSIS)": {
    "prefix": "critical",
    "description": "Save PRIMASK, disable IRQs, restore",
    "body": [
      "uint32_t primask = __get_PRIMASK();",
      "__disable_irq();",
      "${0}",
      "__set_PRIMASK(primask);"
    ]
  },
  "Packed struct": {
    "prefix": "packed",
    "description": "Packed typedef struct",
    "body": [
      "typedef struct __attribute__((packed)) {",
      "\t${0}",
      "} ${1:name}_t;"
    ]
  },
  "Section attribute": {
    "prefix": "section",
    "description": "Place symbol in a linker section",
    "body": [
      "__attribute__((section(\"${1:.ramfunc}\")))"
    ]
  },
  "Weak attribute": {
    "prefix": "weak",
    "description": "Weak symbol attribute",
    "body": [
      "__attribute__((weak))"
    ]
  },
  "Aligned attribute": {
    "prefix": "aligned",
    "description": "Alignment attribute",
    "body": [
      "__attribute__((aligned(${1:4})))"
    ]
  },
  "Unused parameter": {
    "prefix": "unused",
    "description": "Silence unused parameter warning",
    "body": [
      "(void)${1:param};"
    ]
  },
  "Array size macro": {
    "prefix": "arrsize",
    "description": "ARRAY_SIZE macro",
    "body": [
      "#define ARRAY_SIZE(a) (sizeof(a) / sizeof((a)[0]))"
    ]
  },
  "Config default macro": {
    "prefix": "cfgdef",
    "description": "Overridable configuration default",
    "body": [
      "#ifndef ${1:CONFIG_NAME}",
      "#define ${1} ${2:value}",
      "#endif"
    ]
  },
  "Debug print macro": {
    "prefix": "dbgmacro",
    "description": "DBG() printf macro compiled out without DEBUG",
    "body": [
      "#ifdef DEBUG",
      "#define DBG(fmt, ...) ${1:printf}(\"[%s:%d] \" fmt \"\\n\", __FILE__, __LINE__, ##__VA_ARGS__)",
      "#else",
      "#define DBG(fmt, ...) ((void)0)",
      "#endif"
    ]
  },
  "Typedef enum with count": {
    "prefix": "enumt",
    "description": "typedef enum with trailing COUNT",
    "body": [
      "typedef enum {",
      "\t${2:PREFIX}_${3:FIRST},",
      "\t${0}",
      "\t${2}_COUNT",
      "} ${1:name}_t;"
    ]
  },
  "Function pointer typedef": {
    "prefix": "fnptr",
    "description": "Function pointer typedef",
    "body": [
      "typedef ${1:void} (*${2:callback}_t)(${3:void *ctx});"
    ]
  },
  "Bare-metal main": {
    "prefix": "superloop",
    "description": "Embedded main with init and super loop",
    "body": [
      "int main(void)",
      "{",
      "\t${1:system_init();}",
      "",
      "\tfor (;;) {",
      "\t\t${0}",
      "\t}",
      "}"
    ]
  }
}
